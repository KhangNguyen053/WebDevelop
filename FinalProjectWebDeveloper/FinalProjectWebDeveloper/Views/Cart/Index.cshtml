@model IEnumerable<FinalProjectWebDeveloper.Models.CartItemViewModel>
@{
    ViewData["Title"] = "Giỏ Hàng";
    decimal totalAmount = ViewBag.TotalAmount ?? 0;
}
<div class="container py-5" style="color: var(--color-text);">
    <h2 class="fw-bold mb-4 text-uppercase" style="color: var(--color-primary); border-bottom: 2px solid var(--color-primary); padding-bottom: 10px;">
        <i class="bi bi-cart3"></i> Giỏ Hàng Của Bạn
    </h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x" style="font-size: 4rem; color: var(--color-primary);"></i>
            <h4 class="mt-3">Giỏ hàng của bạn đang trống!</h4>
            <p class="text-muted">Hãy chọn cho mình những món ăn nhanh thơm ngon từ menu nhé.</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary px-4 py-2 mt-2" style="border-radius: 8px; border: none;">
                Quay Lại Thực Đơn
            </a>
        </div>
    }
    else
    {
        <div class="row g-5">
            <!-- Table sản phẩm -->
            <div class="col-lg-8">
                <div class="table-responsive">
                    <table class="table align-middle table-hover text-dark">
                        <thead class="text-uppercase" style="color: var(--color-primary); border-bottom: 2px solid var(--color-primary);">
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Kích cỡ</th>
                                <th>Đơn giá</th>
                                <th style="width: 150px;">Số lượng</th>
                                <th>Tổng</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="border-bottom">
                                    <td class="py-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="~/images/@item.ImageURL" alt="@item.ProductName" style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px;">
                                            <div>
                                                <h6 class="fw-bold mb-0" style="color: var(--color-text);">@item.ProductName</h6>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge badge-gold">@item.SizeName</span>
                                    </td>
                                    <td class="text-dark fw-bold">@item.UnitPrice.ToString("N0")đ</td>
                                    <td>
                                        <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productSizeId" value="@item.ProductSizeID" />
                                            <div class="input-group input-group-sm" style="width: 100px;">
                                                <button class="btn btn-outline-primary" type="button" onclick="updateQty(this, -1)">-</button>
                                                <input type="number" class="form-control bg-white text-dark border-primary text-center qty-input" name="quantity" value="@item.Quantity" min="1" readonly style="font-weight: 600;">
                                                <button class="btn btn-outline-primary" type="button" onclick="updateQty(this, 1)">+</button>
                                            </div>
                                        </form>
                                    </td>
                                    <td class="fw-bold text-dark">@item.TotalPrice.ToString("N0")đ</td>
                                    <td>
                                        <form asp-action="RemoveFromCart" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productSizeId" value="@item.ProductSizeID" />
                                            <button type="submit" class="btn btn-link text-danger p-0" onclick="return confirm('Bạn muốn xóa món này khỏi giỏ hàng?')">
                                                <i class="bi bi-trash-fill" style="font-size: 1.2rem;"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tóm tắt giỏ hàng -->
            <div class="col-lg-4">
                <div class="card border-0 p-4 shadow-sm" style="background-color: var(--color-card-bg); color: var(--color-text); border: 1px solid #e0e0e0; border-radius: 12px;">
                    <h5 class="fw-bold mb-4" style="color: var(--color-primary);">TÓM TẮT ĐƠN HÀNG</h5>
                    
                    <div class="d-flex justify-content-between mb-3 text-secondary">
                        <span>Tạm tính:</span>
                        <span class="fw-bold text-dark">@totalAmount.ToString("N0")đ</span>
                    </div>
                    
                    <div class="d-flex justify-content-between mb-4 border-top pt-3">
                        <span class="fw-bold text-dark">Tổng thanh toán:</span>
                        <h4 class="fw-bold mb-0" style="color: var(--color-primary);">@totalAmount.ToString("N0")đ</h4>
                    </div>

                    <a asp-action="Checkout" class="btn btn-primary w-100 py-3 text-uppercase fw-bold" style="border-radius: 8px; border: none;">
                        Tiến Hành Thanh Toán
                    </a>

                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary w-100 py-2 text-uppercase mt-2" style="border-radius: 8px;">
                        Tiếp tục mua hàng
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function updateQty(btn, change) {
            const form = btn.closest('form');
            const qtyInput = form.querySelector('.qty-input');
            let val = parseInt(qtyInput.value);
            if (isNaN(val)) val = 1;
            
            let newVal = val + change;
            if (newVal < 1) newVal = 1;
            
            qtyInput.value = newVal;
            form.submit();
        }
    </script>
}
