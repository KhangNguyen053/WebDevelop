@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FastFoodShop Premium</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- Custom site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm">
            <div class="container">
                <!-- Brand logo -->
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shop" style="font-size: 1.6rem; color: #d4a373;"></i>
                    <span class="text-uppercase fw-bold" style="letter-spacing: 2px; color: var(--color-text);">FastFood<span style="color: var(--color-primary);">Shop</span></span>
                </a>
                
                <button class="navbar-toggler border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarContent">
                    <!-- Navigation links -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link text-uppercase fw-bold" asp-controller="Home" asp-action="Index">Trang Chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-uppercase fw-bold" asp-controller="Product" asp-action="Index">Thực Đơn</a>
                        </li>
                    </ul>
                    
                    <!-- Account & Cart Actions -->
                    <div class="d-flex align-items-center gap-3">
                        <!-- Giỏ hàng -->
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-primary position-relative d-flex align-items-center gap-2 px-3 border-secondary text-white" style="border-radius: 8px; transition: all 0.3s;">
                            <i class="bi bi-cart3" style="font-size: 1.1rem; color: #d4a373;"></i>
                            <span class="d-none d-md-inline small">Giỏ hàng</span>
                        </a>

                        @if (Context.Session.GetString("Username") != null)
                        {
                            <!-- Đã đăng nhập -->
                            <div class="dropdown">
                                <button class="btn btn-outline-primary dropdown-toggle border-secondary text-white d-flex align-items-center gap-2" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false" style="border-radius: 8px;">
                                    <i class="bi bi-person-circle" style="color: #d4a373;"></i>
                                    <span>@Context.Session.GetString("FullName")</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg mt-2" aria-labelledby="userMenu" style="background-color: #1a1512;">
                                    @if (Context.Session.GetInt32("RoleId") == 1)
                                    {
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Index" style="color: #f5efe6;">
                                                <i class="bi bi-speedometer2 me-2" style="color: #d4a373;"></i> Trang quản lý (Admin)
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider bg-secondary"></li>
                                    }
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Account" asp-action="Logout" style="color: #f5efe6;">
                                            <i class="bi bi-box-arrow-right me-2" style="color: #d4a373;"></i> Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <!-- Chưa đăng nhập -->
                            <a asp-controller="Account" asp-action="Login" class="btn btn-link text-decoration-none text-white fw-bold small" style="color: #c8b6a6 !important;">
                                <i class="bi bi-box-arrow-in-right me-1" style="color: #d4a373;"></i> Đăng Nhập
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-primary border-0 px-3" style="background-color: #d4a373; color: #1a1512; font-weight: 600; border-radius: 8px;">
                                Đăng Ký
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="flex-grow-1">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="py-5" style="background-color: #f8f9fa; border-top: 1px solid #e2e8f0; color: var(--color-text);">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5 class="fw-bold text-uppercase mb-3" style="letter-spacing: 1px; color: #000;">FASTFOOD<span style="color: var(--color-primary);">SHOP</span></h5>
                    <p class="small text-secondary">Chúng tôi tự hào mang đến cho khách hàng những món ăn nhanh tươi ngon, nóng hổi và chất lượng vệ sinh an toàn thực phẩm hàng đầu.</p>
                </div>
                <div class="col-md-4">
                    <h5 class="fw-bold text-uppercase mb-3" style="letter-spacing: 1px; color: #000;">LIÊN HỆ</h5>
                    <p class="small mb-1 text-secondary"><i class="bi bi-geo-alt-fill me-2" style="color: var(--color-primary);"></i> <strong>123 Đường Điện Biên Phủ, Quận Bình Thạnh, TP. HCM</strong></p>
                    <p class="small mb-1 text-secondary"><i class="bi bi-telephone-fill me-2" style="color: var(--color-primary);"></i> Hotline: 1900 1234</p>
                    <p class="small text-secondary"><i class="bi bi-envelope-fill me-2" style="color: var(--color-primary);"></i> Email: info@fastfoodshop.com</p>
                </div>
                <div class="col-md-4">
                    <h5 class="fw-bold text-uppercase mb-3" style="letter-spacing: 1px; color: #000;">GIỜ MỞ CỬA</h5>
                    <p class="small mb-1 text-secondary"><strong>Thứ 2 - Thứ Sáu: 07:00 AM - 10:00 PM</strong></p>
                    <p class="small text-secondary">Thứ 7 - Chủ Nhật: 08:00 AM - 11:00 PM</p>
                </div>
            </div>
            <div class="row mt-4 pt-3 border-top text-center text-secondary">
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
