@model IEnumerable<FinalProjectWebDeveloper.Models.Product>
@{
    ViewData["Title"] = "Thực Đơn Món Ăn Nhanh";
    var categories = ViewBag.Categories as IEnumerable<FinalProjectWebDeveloper.Models.Category> ?? new List<FinalProjectWebDeveloper.Models.Category>();
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int? currentCategory = ViewBag.CurrentCategory;
    string? searchTerm = ViewBag.SearchTerm;
    string? sortBy = ViewBag.SortBy;
}

<div class="container py-5" style="color: var(--color-text);">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-uppercase" style="color: var(--color-primary); letter-spacing: 2px;">Danh Mục Sản Phẩm</h1>
        <p class="text-muted">Thưởng thức các món ăn nhanh thơm ngon nóng hổi hấp dẫn nhất</p>
        <div style="height: 3px; width: 80px; background-color: var(--color-primary); margin: 0 auto;"></div>
    </div>

    <div class="row">
        <!-- Sidebar -->
        <div class="col-lg-3 mb-4">
            <div class="card border-0 p-4 shadow-sm" style="background-color: var(--color-card-bg); border: 1px solid #e0e0e0; border-radius: 12px;">
                <!-- Tìm kiếm -->
                <h5 class="fw-bold mb-3" style="color: var(--color-primary); border-left: 3px solid var(--color-primary); padding-left: 10px;">TÌM KIẾM</h5>
                <form asp-action="Index" method="get" class="mb-4">
                    <input type="hidden" name="categoryId" value="@currentCategory" />
                    <input type="hidden" name="sortBy" value="@sortBy" />
                    <div class="input-group">
                        <input type="text" class="form-control bg-white text-dark border-secondary" name="search" value="@searchTerm" placeholder="Nhập tên món ăn..." style="border-top-left-radius: 8px; border-bottom-left-radius: 8px;">
                        <button class="btn btn-primary" type="submit" style="border-top-right-radius: 8px; border-bottom-right-radius: 8px; border: none;">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                <!-- Danh mục loại -->
                <h5 class="fw-bold mb-3" style="color: var(--color-primary); border-left: 3px solid var(--color-primary); padding-left: 10px;">LOẠI MÓN ĂN</h5>
                <div class="list-group list-group-flush mb-4">
                    <a asp-action="Index" asp-route-search="@searchTerm" asp-route-sortBy="@sortBy" class="list-group-item list-group-item-action bg-transparent text-secondary border-0 py-2 ps-0 @(currentCategory == null || currentCategory == 0 ? "fw-bold text-primary text-decoration-underline" : "")" style="transition: all 0.3s;">
                        Tất cả sản phẩm
                    </a>
                    @foreach (var cat in categories)
                    {
                        <a asp-action="Index" asp-route-categoryId="@cat.CategoryID" asp-route-search="@searchTerm" asp-route-sortBy="@sortBy" class="list-group-item list-group-item-action bg-transparent text-secondary border-0 py-2 ps-0 @(currentCategory == cat.CategoryID ? "fw-bold text-primary text-decoration-underline" : "")" style="transition: all 0.3s;">
                            @cat.CategoryName
                        </a>
                    }
                </div>

                <!-- Sắp xếp giá -->
                <h5 class="fw-bold mb-3" style="color: var(--color-primary); border-left: 3px solid var(--color-primary); padding-left: 10px;">SẮP XẾP</h5>
                <div class="list-group list-group-flush">
                    <a asp-action="Index" asp-route-categoryId="@currentCategory" asp-route-search="@searchTerm" asp-route-sortBy="" class="list-group-item list-group-item-action bg-transparent text-secondary border-0 py-2 ps-0 @(string.IsNullOrEmpty(sortBy) ? "fw-bold text-primary text-decoration-underline" : "")">
                        Mặc định
                    </a>
                    <a asp-action="Index" asp-route-categoryId="@currentCategory" asp-route-search="@searchTerm" asp-route-sortBy="price_asc" class="list-group-item list-group-item-action bg-transparent text-secondary border-0 py-2 ps-0 @(sortBy == "price_asc" ? "fw-bold text-primary text-decoration-underline" : "")">
                        Giá: Thấp đến Cao <i class="bi bi-arrow-up-short"></i>
                    </a>
                    <a asp-action="Index" asp-route-categoryId="@currentCategory" asp-route-search="@searchTerm" asp-route-sortBy="price_desc" class="list-group-item list-group-item-action bg-transparent text-secondary border-0 py-2 ps-0 @(sortBy == "price_desc" ? "fw-bold text-primary text-decoration-underline" : "")">
                        Giá: Cao đến Thấp <i class="bi bi-arrow-down-short"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Product Grid -->
        <div class="col-lg-9">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-emoji-frown" style="font-size: 3rem; color: var(--color-primary);"></i>
                    <h4 class="mt-3">Không tìm thấy sản phẩm nào phù hợp</h4>
                    <p class="text-muted">Vui lòng thử lại với từ khóa hoặc bộ lọc khác.</p>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-3 g-4">
                    @foreach (var item in Model)
                    {
                        var minPrice = item.ProductSizes.Any() ? item.ProductSizes.Min(s => s.Price) : 0;
                        <div class="col">
                            <div class="card h-100 border-0 shadow-sm" style="background-color: var(--color-card-bg); color: var(--color-text); border: 1px solid #e0e0e0; border-radius: 12px; transition: transform 0.3s ease, box-shadow 0.3s ease; overflow: hidden;" onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 20px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                                <div class="position-relative" style="height: 200px; overflow: hidden;">
                                    <img src="~/images/@item.ImageURL" class="card-img-top h-100 w-100" alt="@item.ProductName" style="object-fit: cover; transition: transform 0.5s ease;" onmouseover="this.style.transform='scale(1.1)';" onmouseout="this.style.transform='scale(1)';">
                                    <span class="position-absolute top-0 end-0 m-2 badge badge-gold px-3 py-2">
                                        @item.Category?.CategoryName
                                    </span>
                                </div>
                                <div class="card-body d-flex flex-column p-4">
                                    <h5 class="card-title fw-bold text-truncate mb-2" style="color: var(--color-text);">@item.ProductName</h5>

                                    <div class="d-flex justify-content-between align-items-center mt-auto">
                                        <div>
                                            <span class="small text-muted block" style="font-size: 0.75rem;">Giá từ</span>
                                            <h5 class="fw-bold mb-0 text-dark">@minPrice.ToString("N0")đ</h5>
                                        </div>
                                        <a asp-action="Detail" asp-route-id="@item.ProductID" class="btn btn-outline-primary border-1 px-3 py-2 text-uppercase fw-bold" style="border-radius: 8px; font-size: 0.8rem;">
                                            Xem chi tiết
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <nav class="mt-5">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link border-0 text-dark bg-transparent" asp-action="Index" asp-route-categoryId="@currentCategory" asp-route-search="@searchTerm" asp-route-sortBy="@sortBy" asp-route-page="@(currentPage - 1)">
                                    <i class="bi bi-chevron-left" style="color: var(--color-primary);"></i>
                                </a>
                            </li>

                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link border-0 mx-1 rounded @(i == currentPage ? "active-page text-white" : "bg-transparent text-dark")" asp-action="Index" asp-route-categoryId="@currentCategory" asp-route-search="@searchTerm" asp-route-sortBy="@sortBy" asp-route-page="@i">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link border-0 text-dark bg-transparent" asp-action="Index" asp-route-categoryId="@currentCategory" asp-route-search="@searchTerm" asp-route-sortBy="@sortBy" asp-route-page="@(currentPage + 1)">
                                    <i class="bi bi-chevron-right" style="color: var(--color-primary);"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>
